<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Configurations>Debug;Release;XPlat;XPlatRelease</Configurations>
  </PropertyGroup>

  <!-- 3D rendering: Aquarium (https://github.com/merschformann/aquarium) from NuGet. For working on both at the same time,
       a local checkout can be used instead (absolute path): dotnet build -p:AquariumDir=$PWD/../aquarium/ -->
  <PropertyGroup>
    <AquariumVersion>0.1.0</AquariumVersion>
  </PropertyGroup>
  <ItemGroup Condition=" '$(AquariumDir)' == '' ">
    <PackageReference Include="Aquarium.Avalonia" Version="$(AquariumVersion)" />
  </ItemGroup>
  <ItemGroup Condition=" '$(AquariumDir)' != '' ">
    <ProjectReference Include="$(AquariumDir)src\Aquarium.Avalonia\Aquarium.Avalonia.csproj" />
  </ItemGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'XPlatRelease' ">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RAWSimO.Core\RAWSimO.Core.csproj" />
    <ProjectReference Include="..\RAWSimO.Toolbox\RAWSimO.Toolbox.csproj" />
    <ProjectReference Include="..\RAWSimO.DataPreparation\RAWSimO.DataPreparation.csproj" />
    <ProjectReference Include="..\RAWSimO.CommFramework\RAWSimO.CommFramework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RAWSimO.Visualization.Avalonia.Tests" />
  </ItemGroup>
</Project>
