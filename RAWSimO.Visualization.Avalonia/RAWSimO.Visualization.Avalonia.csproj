<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Configurations>Debug;Release;XPlat;XPlatRelease</Configurations>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Location of the Aquarium repository (can be overridden, e.g. dotnet build -p:AquariumDir=/path/to/aquarium/) -->
    <AquariumDir Condition=" '$(AquariumDir)' == '' ">$(MSBuildThisFileDirectory)..\..\aquarium\</AquariumDir>
  </PropertyGroup>

  <Target Name="CheckAquarium" BeforeTargets="PrepareForBuild;_CheckForInvalidConfigurationAndPlatform;CollectPackageReferences">
    <Error Condition="!Exists('$(AquariumDir)src\Aquarium.Avalonia\Aquarium.Avalonia.csproj')"
           Text="The 3D component Aquarium was not found at '$(AquariumDir)'. Clone https://github.com/merschformann/aquarium next to RAWSim-O (or set AquariumDir)." />
  </Target>

  <PropertyGroup Condition=" '$(Configuration)' == 'XPlatRelease' ">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RAWSimO.Core\RAWSimO.Core.csproj" />
    <ProjectReference Include="..\RAWSimO.Toolbox\RAWSimO.Toolbox.csproj" />
    <ProjectReference Include="..\RAWSimO.DataPreparation\RAWSimO.DataPreparation.csproj" />
    <ProjectReference Include="..\RAWSimO.CommFramework\RAWSimO.CommFramework.csproj" />
    <!-- 3D rendering: the Aquarium repository (https://github.com/merschformann/aquarium) checked out next to this one -->
    <ProjectReference Include="$(AquariumDir)src\Aquarium.Avalonia\Aquarium.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RAWSimO.Visualization.Avalonia.Tests" />
  </ItemGroup>
</Project>
