<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:RAWSimO.Visualization.Avalonia.Controls"
        x:Class="RAWSimO.Visualization.Avalonia.MainWindow"
        Title="RAWSim-O"
        Width="1400" Height="900" MinWidth="800" MinHeight="500">

  <Window.Styles>
    <Style Selector="StackPanel.toolbar > :is(Control)">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Margin" Value="8,0,4,0" />
      <Setter Property="Foreground" Value="#555" />
    </Style>
    <Style Selector="TabControl#SidePanel > TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,4" />
    </Style>
    <Style Selector="Separator.vertical">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Background" Value="#ccc" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" BorderBrush="#ddd" BorderThickness="0,0,0,1" Padding="6">
      <WrapPanel Orientation="Horizontal">
        <StackPanel Classes="toolbar" Orientation="Horizontal" Spacing="4" Margin="0,2">
          <ToggleButton x:Name="TogglePanel" Content="☰" IsChecked="True" ToolTip.Tip="Show / hide the configuration panel" IsCheckedChanged="TogglePanel_Changed" />
          <Button x:Name="ButtonGenerate" Content="Generate" ToolTip.Tip="Generate an instance using the layout, setting and controller configuration of the 'Instance' panel" Click="ButtonGenerate_Click" />
          <Button x:Name="ButtonLoad" Content="Load…" ToolTip.Tip="Load an instance or layout file together with a setting and a control configuration" Click="ButtonLoad_Click" />
          <Separator Classes="vertical" />
          <Button x:Name="ButtonPlayPause" Content="▶ Start" MinWidth="80" ToolTip.Tip="Start / pause the simulation (Space)" Click="ButtonPlayPause_Click" />
          <Button x:Name="ButtonStop" Content="■ Stop" ToolTip.Tip="Stop the simulation" Click="ButtonStop_Click" />
          <TextBlock Classes="label" Text="Speed" />
          <NumericUpDown x:Name="NumericSpeed" Minimum="1" Maximum="400" Increment="1" Value="1" FormatString="0" Width="110"
                         ToolTip.Tip="Simulated seconds per real second (+ / - / 0-4)" ValueChanged="NumericSpeed_ValueChanged" />
          <TextBlock x:Name="TextTime" Classes="label" Text="00:00:00" FontFamily="monospace" MinWidth="80" ToolTip.Tip="Current simulation time" />
        </StackPanel>
        <StackPanel Classes="toolbar" Orientation="Horizontal" Spacing="4" Margin="0,2">
          <Separator Classes="vertical" />
          <TextBlock Classes="label" Text="Tier" />
          <ComboBox x:Name="ComboTier" MinWidth="60" ToolTip.Tip="Tier to display (PageUp / PageDown)" SelectionChanged="ComboTier_SelectionChanged" />
          <TextBlock Classes="label" Text="Detail" />
          <ComboBox x:Name="ComboDetail" MinWidth="110" ToolTip.Tip="Level of detail of the static content" SelectionChanged="ComboDetail_SelectionChanged" />
          <TextBlock Classes="label" Text="Bot colors" />
          <ComboBox x:Name="ComboBotColors" MinWidth="170" SelectionChanged="RenderOption_Changed" />
        </StackPanel>
        <StackPanel Classes="toolbar" Orientation="Horizontal" Spacing="12" Margin="0,2">
          <Separator Classes="vertical" />
          <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Color pods by their heat according to the selected measure">
            <TextBlock Classes="label" Text="Pod heat" VerticalAlignment="Center" />
            <ComboBox x:Name="ComboHeatMode" MinWidth="150" SelectionChanged="RenderOption_Changed" />
          </StackPanel>
          <CheckBox x:Name="CheckGoal" Content="Goal" ToolTip.Tip="Draw a line from each bot to its current goal" IsCheckedChanged="RenderOption_Changed" />
          <CheckBox x:Name="CheckDestination" Content="Destination" ToolTip.Tip="Draw a line from each bot to its destination" IsCheckedChanged="RenderOption_Changed" />
          <CheckBox x:Name="CheckPath" Content="Path" ToolTip.Tip="Draw the planned path of each bot" IsCheckedChanged="RenderOption_Changed" />
          <Separator Classes="vertical" />
          <Button x:Name="ButtonFit" Content="Fit" ToolTip.Tip="Fit the tier into the view (F or double click)" Click="ButtonFit_Click" />
          <Button x:Name="ButtonSnapshot" Content="Snapshot…" ToolTip.Tip="Export the complete tier as PNG or SVG (vector graphics)" Click="ButtonSnapshot_Click" />
        </StackPanel>
      </WrapPanel>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" BorderBrush="#ddd" BorderThickness="0,1,0,0" Padding="8,3">
      <DockPanel>
        <TextBlock x:Name="TextFps" DockPanel.Dock="Right" FontFamily="monospace" Foreground="#555" />
        <TextBlock x:Name="TextStatus" Text="Generate or load an instance to start." TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Log -->
    <TextBox x:Name="TextLog" DockPanel.Dock="Bottom" Height="110" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
             FontFamily="monospace" FontSize="11" BorderThickness="0,1,0,0" CornerRadius="0" />

    <!-- Info panel -->
    <Border DockPanel.Dock="Right" Width="280" BorderBrush="#ddd" BorderThickness="1,0,0,0" Padding="8">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Selection" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ScrollViewer>
          <SelectableTextBlock x:Name="TextInfo" Text="Click on a bot, pod or station to see details." TextWrapping="Wrap" FontFamily="monospace" FontSize="12" />
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- Configuration panel, splitter and simulation view -->
    <Grid x:Name="MainGrid" ColumnDefinitions="440,Auto,*">
      <TabControl x:Name="SidePanel" Grid.Column="0" Padding="0" Margin="4,0,0,0">
        <TabItem Header="Instance">
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="6,4">
              <Button Content="Generate" Margin="0,0,4,4" Click="ButtonGenerate_Click" ToolTip.Tip="Generate an instance with the parameters below" />
              <Button x:Name="ButtonSanityCheck" Content="Sanity check" Margin="0,0,4,4" Click="ButtonSanityCheck_Click" ToolTip.Tip="Check the current instance for obvious errors" />
              <Button Content="Reset" Margin="0,0,4,4" Click="ButtonResetConfigs_Click" ToolTip.Tip="Reset all parameters below to their defaults" />
              <Button x:Name="ButtonSaveInstance" Content="Save instance…" Margin="0,0,4,4" Click="ButtonSaveInstance_Click" ToolTip.Tip="Save the current instance (.xinst)" />
              <Button Content="Save layout…" Margin="0,0,4,4" Click="ButtonSaveLayout_Click" ToolTip.Tip="Save the layout configuration (.xlayo)" />
              <Button Content="Save setting…" Margin="0,0,4,4" Click="ButtonSaveSetting_Click" ToolTip.Tip="Save the setting configuration (.xsett)" />
              <Button Content="Save controller…" Margin="0,0,4,4" Click="ButtonSaveControl_Click" ToolTip.Tip="Save the controller configuration (.xconf)" />
            </WrapPanel>
            <ScrollViewer>
              <StackPanel Margin="6,0,14,6" Spacing="4">
                <Expander Header="Layout" IsExpanded="True" HorizontalAlignment="Stretch"><ContentControl x:Name="EditorLayout" /></Expander>
                <Expander Header="Setting" HorizontalAlignment="Stretch"><ContentControl x:Name="EditorSetting" /></Expander>
                <Expander Header="Controller" HorizontalAlignment="Stretch"><ContentControl x:Name="EditorControl" /></Expander>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>
        <TabItem Header="Orders">
          <ScrollViewer>
            <StackPanel Margin="6,4,14,6" Spacing="4">
              <Expander Header="Simple item generator" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <ContentControl x:Name="EditorSimpleItems" />
                  <Button Content="Generate and save item config…" Click="ButtonSaveSimpleItemConfig_Click"
                          ToolTip.Tip="Generate a configuration for the online generation of simple items (.xgenc) and plot its frequencies (requires gnuplot)" />
                </StackPanel>
              </Expander>
              <Expander Header="Alphabet order list" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <ContentControl x:Name="EditorAlphabetOrders" />
                  <Button Content="Generate and save order list…" Click="ButtonSaveAlphabetOrders_Click"
                          ToolTip.Tip="Generate an order list based on colored words for the fixed inventory mode (.xitem)" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Misc">
          <ScrollViewer>
            <StackPanel Margin="6,4,14,6" Spacing="4">
              <Expander Header="Statistics" IsExpanded="True" HorizontalAlignment="Stretch">
                <StackPanel Spacing="6">
                  <CheckBox x:Name="CheckWriteStatistics" Content="Write statistics to folder when the simulation stops"
                            ToolTip.Tip="If disabled, statistics are only written when the simulation horizon is reached (to a folder in the working directory)" />
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Margin="4,0,0,0" Click="ButtonBrowseStatistics_Click" />
                    <TextBox x:Name="TextStatisticsFolder" PlaceholderText="Statistics output folder" />
                  </DockPanel>
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <GridSplitter x:Name="SidePanelSplitter" Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#e6e6e6" />
      <c:SimulationView x:Name="View" Grid.Column="2" />
    </Grid>
  </DockPanel>
</Window>
