<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>An Avalonia control rendering Aquarium scenes (many instanced shapes) with OpenGL: orbit camera, picking and screenshots.</Description>
    <PackageTags>avalonia;3d;opengl;instancing;visualization</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aquarium\Aquarium.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
